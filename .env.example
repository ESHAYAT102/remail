# true  = fixture mail + local session (pnpm dev)
# false = Postgres + Resend
DEMO_MODE=true

# App (live mode)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-value
# Versioned keys make encrypted OAuth-token rotation possible. Put the current
# key first; keep older versions until every stored grant has been refreshed.
# For a new environment, use the same generated value in both settings.
BETTER_AUTH_SECRETS=1:replace-with-openssl-rand-base64-32-value
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in and Gmail OAuth (live mode only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Gmail push sync. The audience should exactly match the authenticated
# Pub/Sub push subscription audience.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
MAIL_SYNC_CRON_SECRET=

# Postgres (live mode)
DATABASE_URL=postgres://remail:remail@localhost:5432/remail
